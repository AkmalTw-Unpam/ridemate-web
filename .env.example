# ============================================================
# RideMate Web — contoh konfigurasi
# ============================================================
#
# Salin berkas ini jadi .env lalu isi nilainya.
# .env TIDAK boleh ikut masuk Git: ia sudah ada di .gitignore.
#
# ATURAN PENTING: hanya variabel berawalan VITE_ yang sampai ke browser,
# dan semua yang sampai ke browser BISA DIBACA SIAPA PUN yang membuka
# situsnya. Jadi jangan pernah menaruh service role key Supabase, kunci
# Firebase, atau rahasia apa pun di sini. Kunci anon Supabase boleh —
# ia memang dirancang untuk publik dan dijaga RLS.

# Alamat REST API. Kosongkan untuk memakai data demo.
# Contoh Supabase: https://xxxx.supabase.co/rest/v1
VITE_API_BASE_URL=

# Kunci publik API, kalau backend-nya membutuhkan.
# Untuk Supabase ini kunci ANON, bukan service role.
VITE_API_PUBLIC_KEY=

# Tautan Play Store. Selama kosong, tombol unduh menampilkan
# "Segera hadir di Play Store" dan tidak mengarah ke mana pun.
VITE_PLAY_STORE_URL=

# Kontak dan media sosial. Yang kosong tidak ditampilkan.
VITE_CONTACT_EMAIL=
VITE_INSTAGRAM_URL=
VITE_YOUTUBE_URL=
